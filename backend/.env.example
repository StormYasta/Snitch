# Copie para backend/.env. Nunca faça commit do arquivo com credenciais.
# Use a URL exata obtida em Supabase > Connect > Session Pooler (porta 5432).
# Codifique caracteres especiais da senha para uso na URL.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
AUTO_CREATE_TABLES=false
LOAD_DEMO_SEED=false
CORS_ORIGINS='["https://stormyasta.github.io","http://localhost:5173","http://localhost:3000"]'
CAMARA_API_URL=https://dadosabertos.camara.leg.br/api/v2
PRESENCE_TTL_HOURS=6
EXPENSES_TTL_HOURS=24
# Defina um token aleatório longo; não envie para o frontend.
SYNC_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
