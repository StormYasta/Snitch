# Local: deixe VITE_API_URL vazio para usar o proxy /api do Vite.
# Produção no GitHub Pages: indique a URL pública HTTPS do FastAPI, incluindo /api.
VITE_API_URL=
# Deploy normal em /Snitch/: sobrescrito pelo GitHub Actions.
VITE_BASE_PATH=/
# Produção estática usa hash para evitar 404 ao recarregar rotas.
VITE_ROUTER_MODE=browser
